# Base URL of the Kavodnik API including /api/v1.
# Absolute (e.g. https://api.kavodnik.com/api/v1) or relative (/api/v1) when the admin is served
# from the same origin as the API or through a reverse proxy.
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Google OAuth *Web* client id. It is public (it ends up in the browser) and must be one of the
# backend's GOOGLE_CLIENT_ID values so the ID token audience is accepted.
VITE_GOOGLE_CLIENT_ID=

# Development only: where the Vite dev server proxies /api and /actuator.
VITE_DEV_PROXY_TARGET=http://localhost:8080
